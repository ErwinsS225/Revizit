// prisma/schema.prisma — PostgreSQL (Supabase) : dev et production partagent la même base.
// Le fichier SQLite local (prisma/dev.db) n'est plus utilisé : il est éphémère et
// perd ses données à chaque redéploiement sur Vercel.
//
// NOTE : Role / Gender / OrderStatus restent stockés en String (et non en enum) pour
// ne pas casser les types existants (types/*.ts) ni la validation zod. Functionnel
// sous Postgres, et plus simple à faire évoluer.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connexion directe : reserved aux migrations (prisma migrate).
  // Utile car le pooler transactionnel de Supabase ne gère pas les DDL.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String   @default("CUSTOMER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts   Account[]
  sessions   Session[]
  addresses  Address[]
  reviews    Review[]
  orders     Order[]
  cart       Cart?
  wishlist   Wishlist[]
  resetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

/// Jeton de réinitialisation de mot de passe (page /forgot-password).
/// Modèle SÉPARÉ de VerificationToken (réservé à Auth.js) : le préfixe
/// `reset:` dans l'identifiant permet de distinguer les deux usages et
/// d'invalider tous les reset en cours d'un seul DELETE au changement d'email.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  /// Hash SHA-256 du token : en cas de fuite de la base, le token brut
  /// n'est pas récupérable et le lien de réinitialisation est inexploitable.
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  street     String
  city       String
  postalCode String
  country    String   @default("France")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  parentId    String?
  createdAt   DateTime @default(now())
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String
  price          Int
  compareAtPrice Int?
  images         String   @default("[]")
  categoryId     String?
  brand          String?
  stock          Int      @default(0)
  sku            String?  @unique
  isFeatured     Boolean  @default(false)
  isActive       Boolean  @default(true)
  tags           String   @default("[]")
  gender         String   @default("UNISEX")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlist   Wishlist[]
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  size          String
  color         String?
  stock         Int     @default(0)
  priceModifier Int     @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  @@unique([productId, size, color])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([productId, userId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int    @default(1)
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([cartId, productId, variantId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          String   @default("PENDING")
  total           Int
  addressId       String?
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address?   @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  unitPrice Int
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
}

/// Bloc de contenu éditorial de la page d'accueil, administrable depuis
/// /admin/contenu. La clé identifie la section (« hero », « univers »,
/// « verrerie », « selection »…) : le code de la home la lit par cette clé.
///
/// `image` et `imageAlt` : URL complète (Unsplash ou CDN). Champ unique non
/// requis : toutes les sections n'ont pas d'image de bannière.
model ContentBlock {
  id        String   @id @default(cuid())
  /// Identifiant stable de la section. Ne pas le changer : le code l'utilise.
  key       String   @unique
  /// Titre principal (H2 de la section, ou titre d'une slide).
  title     String
  /// Sur-titre affiché au-dessus (souvent en petites capitales dorées).
  eyebrow   String?
  /// Texte d'introduction / sous-titre.
  subtitle  String?
  /// Libellé du bouton d'appel à l'action.
  ctaLabel  String?
  /// Cible du bouton (chemin interne, ex. "/products?category=verrerie").
  ctaHref   String?
  /// URL de l'image de la section.
  image     String?
  /// Texte alternatif — indispensable pour l'accessibilité et le SEO.
  imageAlt  String?
  /// Rang d'affichage (les blocs homonymes sont triés dessus).
  position  Int      @default(0)
  /// Le bloc est-il publié ? Un bloc masqué retombe sur ses valeurs par défaut.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

/// Disposition de la page d'accueil : ordre d'affichage et visibilité de
/// chaque section, administrable depuis /admin/contenu.
///
/// Séparé de ContentBlock : réordonner ou masquer une section ne doit pas
/// dépendre du fait qu'elle ait du texte personnalisé. Tant qu'aucune ligne
/// n'existe pour une section, c'est la disposition par défaut du code
/// (HOME_SECTIONS dans lib/content.ts) qui s'applique.
model HomeLayout {
  /// Identifiant de la section (ex. « hero », « promo », « avis »).
  key       String   @id
  /// Rang d'affichage, croissant. 0 = premier.
  position  Int      @default(0)
  /// Section affichée sur la page d'accueil ?
  isVisible Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

