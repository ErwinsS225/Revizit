# ── Base de données : PostgreSQL Supabase ────────────────────────────────
# Supabase → Project Settings → Database → Connection string
# DATABASE_URL  : pooler transactionnel (port 6543) — utilisé par l'app à l'exécution.
#                 Ajoute ?pgbouncer=true&connection_limit=1 sur Vercel.
# DIRECT_URL    : connexion directe (port 5432) — réservée aux migrations Prisma.
# Ne JAMAIS commit ces deux valeurs : elles sont ignorées via .gitignore.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Seed : ne jamais passer à "true" en production (purge destructrice + comptes de démo).
SEED_DEMO_USERS="false"

# Auth.js (NextAuth v5)
AUTH_SECRET="change-me-en-prod-min-32-caracteres"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (mode test)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Emails (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Boutique <commandes@example.com>"
