# ── Base de données : PostgreSQL (Supabase) ──────────────────────────────
# NE JAMAIS committer de vraies valeurs ici : ce fichier est le GABARIT public.
#
# Supabase → Project Settings → Database → Connection string
#   DATABASE_URL : pooler transactionnel (port 6543) — utilisé par l'app à l'exécution.
#                  Sur Vercel (serverless), ajouter ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   : connexion directe (port 5432) — réservée aux migrations Prisma.
#
# ⚠️ connection_limit : NE PAS le mettre à 1 en développement local.
#    La page d'accueil lance 4 requêtes Prisma en parallèle (Promise.all) :
#    avec une seule connexion, Prisma se met en file d'attente et la page
#    finit par échouer sur « Timed out fetching a new connection ».
#    - Local    : omettre le paramètre (pool par défaut)
#    - Vercel   : connection_limit=1 (chaque invocation a son propre runtime,
#                 le pooler Supabase protège le quota de connexions)
DATABASE_URL="postgresql://postgres.PROJECT_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ── Supabase Storage (upload d'images depuis l'admin) ─────────────────────
# NEXT_PUBLIC_SUPABASE_URL est déjà public (c'est l'URL du projet).
# SUPABASE_SECRET_KEY ne doit JAMAIS être exposé au navigateur : il est
# utilisé uniquement par /api/admin/upload (côté serveur). N'utilisez pas
# la clé anonyme ici : elle suffirait pour un bucket public, mais la clé
# secrète est la seule garantie si le bucket passe en privé un jour.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# Seed : laisser "false" en production.
# Le seed purge la base et crée des comptes de démonstration (admin@shop.com / Admin123!)
# qui donneraient un accès total au back-office. À n'utiliser que sur une base jetable.
SEED_DEMO_USERS="false"

# Auth.js (NextAuth v5)
AUTH_SECRET="change-me-en-prod-min-32-caracteres"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (mode test)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Emails (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Boutique <commandes@example.com>"
