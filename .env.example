# ── Base de données : PostgreSQL (Supabase) ──────────────────────────────
# NE JAMAIS committer de vraies valeurs ici : ce fichier est le GABARIT public.
#
# Supabase → Project Settings → Database → Connection string
#   DATABASE_URL : pooler transactionnel (port 6543) — utilisé par l'app à l'exécution.
#                  Sur Vercel, ajouter ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   : connexion directe (port 5432) — réservée aux migrations Prisma.
#
# ⚠️ Le mot de passe est celui que vous avez défini dans Supabase.
# ⚠️ Ces deux URLs contiennent un secret : ne les committez JAMAIS.
DATABASE_URL="postgresql://postgres.PROJECT_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Seed : laisser "false" en production.
# Le seed purge la base et crée des comptes de démonstration (admin@shop.com / Admin123!)
# qui donneraient un accès total au back-office. À n'utiliser que sur une base jetable.
SEED_DEMO_USERS="false"

# Auth.js (NextAuth v5)
AUTH_SECRET="change-me-en-prod-min-32-caracteres"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (mode test)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Emails (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Boutique <commandes@example.com>"
